{
  "name": "scrapmind",
  "version": "0.1.0-alpha.6",
  "private": true,
  "description": "Turn the materials and devices you already own into useful things. Inventory-constrained plans, guided builds, and evidence-based Device Alchemy.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && node dist/scripts/browser-check.js",
    "demo": "tsx scripts/cli.ts demo",
    "plan": "tsx scripts/cli.ts plan",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "tsx --env-file-if-exists=.env scripts/server.ts",
    "invent": "tsx --env-file-if-exists=.env scripts/cli.ts invent",
    "evaluate": "tsx --env-file-if-exists=.env scripts/evaluate.ts",
    "workbench": "tsx --env-file-if-exists=.env scripts/workbench-cli.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
