# Optional. No model is contacted unless you explicitly request an invention.
# For a local OpenAI-compatible model server such as Ollama:
SCRAPMIND_AI_BASE_URL=http://127.0.0.1:11434/v1
SCRAPMIND_AI_MODEL=your-installed-model
# Optional compatibility fallback for providers without JSON-schema output:
# SCRAPMIND_AI_FORMAT=json_object
# Optional reasoning-model compatibility: uses max_completion_tokens, omits temperature.
# SCRAPMIND_AI_PROFILE=reasoning
# Optional per-call output limit (1024–32768; includes reasoning tokens for reasoning models).
# SCRAPMIND_AI_MAX_OUTPUT_TOKENS=16384
# Optional critic model at the same configured endpoint; defaults to the generation model.
# SCRAPMIND_AI_REVIEW_MODEL=your-review-model
# Optional photo suggestions require an explicitly configured vision-capable model.
# SCRAPMIND_AI_VISION_MODEL=your-vision-model
# Only needed for a provider that requires authentication. Never commit your key.
# SCRAPMIND_AI_KEY=
